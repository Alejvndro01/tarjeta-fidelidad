# ============================================================
# Variables de entorno para PRODUCCIÓN (copiar a .env.prod y llenar).
# NUNCA commitear este archivo con valores reales — solo credenciales de ejemplo.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=loyalty
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD_SEGURA
# Conexión usada por la API (red interna composable / servicio postgres).
# Host=postgres cuando api y postgres comparten la red del compose.
LOYALTY_DB_CONNECTION=Host=postgres;Port=5432;Database=loyalty;Username=loyalty;Password=REEMPLAZAR_PASSWORD_SEGURA;SslMode=Disable

# --- JWT ---
# Clave simétrica para firmar tokens (≥32 bytes). Generar con:
#   openssl rand -base64 48
JWT_SECRET_KEY=REEMPLAZAR_CLAVE_JWT

# --- CORS (orígenes permitidos para la PWA/admin) ---
CORS_ORIGIN_1=https://admin.tumarca.cl
CORS_ORIGIN_2=https://tumarca.cl

# --- Seed de usuarios demo ---
# Dejar vacío en producción para NO sembrar credenciales demo; los admins
# deben crearse por otra vía segura. Solo útil en staging/dev como valor temporal.
SEED_DEMO_PASSWORD=

# --- Wallet (si la marca usa Apple/Google Wallet) ---
# Ruta (dentro del contenedor) al .p12 comercial de Apple PassKit + su password.
LOYALTY_PKCS12_PATH=/run/secrets/pass.p12
LOYALTY_PKCS12_PASSWORD=REEMPLAZAR
# Service-account JSON de Google Wallet (contenido minificado).
LOYALTY_GOOGLE_KEY=

# --- Puerto de la API en el host ---
API_PORT=8080