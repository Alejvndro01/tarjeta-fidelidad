{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "Configuration": "127.0.0.1:6379",
    "InstanceName": "loyalty:"
  },
  "Jwt": {
    "Issuer": "loyalty-api",
    "Audience": "loyalty-pwa",
    "AccessTokenMinutes": 60,
    "RefreshTokenMinutes": 10080
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"]
  }
}